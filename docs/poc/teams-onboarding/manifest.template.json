{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.21/MicrosoftTeams.schema.json",
  "manifestVersion": "1.21",
  "version": "1.1.0",
  "id": "__TEAMS_APP_ID__",
  "developer": {
    "name": "Application Support",
    "websiteUrl": "https://example.invalid",
    "privacyUrl": "https://example.invalid/privacy",
    "termsOfUseUrl": "https://example.invalid/terms"
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "name": {
    "short": "Application Support",
    "full": "Application Support \u2014 Teams"
  },
  "description": {
    "short": "Support inbox for standard channels in your selected Teams team.",
    "full": "Application Support receives support messages and replies in standard channels of the team where this app is installed. Resource-specific consent grants message reading and channel discovery only in that team."
  },
  "accentColor": "#FFFFFF",
  "webApplicationInfo": {
    "id": "__TEAMS_BOT_CLIENT_ID__",
    "resource": "api://botid-__TEAMS_BOT_CLIENT_ID__"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "type": "Application",
          "name": "ChannelMessage.Read.Group"
        },
        {
          "type": "Application",
          "name": "ChannelSettings.Read.Group"
        }
      ]
    }
  },
  "bots": [
    {
      "botId": "__TEAMS_BOT_CLIENT_ID__",
      "scopes": [
        "team"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "validDomains": []
}
