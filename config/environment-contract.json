  "runtimeSecretProfiles": ["staging", "prod", "production"],
  "integrationSecretPersistence": {
    "storedField": "secret_ref",
    "resolvedValueStoredInDatabase": false,
    "bulkImportedIntoApplicationEnvironment": false
  },
  "coreSecretFiles": [
    "spring.datasource.username",
    "spring.datasource.password",
    "spring.rabbitmq.username",
    "spring.rabbitmq.password",
    "usi.object-storage.access-key",
    "usi.object-storage.secret-key"
  ],
  "forbiddenProviderSecretEnvironmentNames": [
    "USI_SLACK_SIGNING_SECRET",
    "USI_SLACK_CLIENT_SECRET",
    "USI_SLACK_BOT_TOKEN",
    "USI_SLACK_APP_TOKEN",
