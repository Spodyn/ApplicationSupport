      "type": "non-empty",
      "requiredProfiles": ["local"],
      "allowedProfiles": ["local"]
    },
    "USI_DATABASE_PASSWORD": {
      "classification": "local-secret",
      "type": "non-empty",
      "requiredProfiles": ["local"],
      "allowedProfiles": ["local"]
    },
    "USI_RABBITMQ_USERNAME": {
      "classification": "local-secret",
      "type": "non-empty",
      "requiredProfiles": ["local"],
      "allowedProfiles": ["local"]
    },
    "USI_RABBITMQ_PASSWORD": {
      "classification": "local-secret",
      "type": "non-empty",
      "requiredProfiles": ["local"],
      "allowedProfiles": ["local"]
    },
    "USI_OBJECT_STORAGE_ACCESS_KEY": {
      "classification": "local-secret",
      "type": "non-empty",
      "requiredProfiles": ["local"],
      "allowedProfiles": ["local"]
    },
    "USI_OBJECT_STORAGE_SECRET_KEY": {
      "classification": "local-secret",
      "type": "non-empty",
      "requiredProfiles": ["local"],
      "allowedProfiles": ["local"]
    },
    "USI_CORE_SECRETS_DIRECTORY": {
      "classification": "secret-location",
      "type": "absolute-directory",
      "requiredProfiles": ["staging", "prod", "production"],
      "allowedProfiles": ["staging", "prod", "production"]
    },
    "USI_INTEGRATION_SECRETS_DIRECTORY": {
      "classification": "secret-location",
      "type": "absolute-directory",
      "requiredProfiles": ["local", "staging", "prod", "production"],
      "allowedProfiles": ["local", "staging", "prod", "production"]
    }
