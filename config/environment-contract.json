{
  "version": 1,
  "profiles": [
    "local",
    "test",
    "staging",
    "prod",
    "production"
  ],
  "publicVariables": {
    "NEXT_PUBLIC_API_BASE_URL": {
      "classification": "browser-public",
      "type": "same-origin-path",
      "required": true,
      "exactValue": "/api/v1"
    },
    "NEXT_PUBLIC_WS_BASE_URL": {
      "classification": "browser-public",
      "type": "same-origin-path",
      "required": true,
      "exactValue": "/ws"
    }
  },
  "backendVariables": {
    "SPRING_PROFILES_ACTIVE": {
      "classification": "server-non-secret",
      "type": "profile",
      "requiredProfiles": ["local", "test", "staging", "prod", "production"]
    },
    "USI_PUBLIC_BASE_URL": {
      "classification": "server-non-secret",
      "type": "origin",
      "requiredProfiles": ["local", "test", "staging", "prod", "production"],
      "httpsProfiles": ["staging", "prod", "production"]
    },
    "USI_SLACK_CALLBACK_URL": {
      "classification": "server-non-secret",
      "type": "https-url",
      "requiredProfiles": ["local", "test", "staging", "prod", "production"],
      "pathPrefix": "/api/v1"
    },
    "USI_TEAMS_CALLBACK_URL": {
      "classification": "server-non-secret",
      "type": "https-url",
      "requiredProfiles": ["local", "test", "staging", "prod", "production"],
      "pathPrefix": "/api/v1"
    },
    "USI_TELEGRAM_CALLBACK_URL": {
      "classification": "server-non-secret",
      "type": "https-url",
      "requiredProfiles": ["local", "test", "staging", "prod", "production"],
      "pathPrefix": "/api/v1"
    },
    "USI_CORS_ALLOWED_ORIGINS": {
      "classification": "server-non-secret",
      "type": "origin-list",
      "requiredProfiles": []
    },
    "USI_DATABASE_URL": {
      "classification": "server-non-secret",
      "type": "jdbc-postgresql-url",
      "requiredProfiles": ["local", "staging", "prod", "production"]
    },
    "USI_RABBITMQ_HOST": {
      "classification": "server-non-secret",
      "type": "hostname",
      "requiredProfiles": ["local", "staging", "prod", "production"]
    },
    "USI_RABBITMQ_PORT": {
      "classification": "server-non-secret",
      "type": "port",
      "requiredProfiles": ["local", "staging", "prod", "production"]
    },
    "USI_RABBITMQ_VHOST": {
      "classification": "server-non-secret",
      "type": "non-empty",
      "requiredProfiles": ["local", "staging", "prod", "production"]
    },
    "USI_OBJECT_STORAGE_ENDPOINT": {
      "classification": "server-non-secret",
      "type": "web-url",
      "requiredProfiles": ["local", "staging", "prod", "production"],
