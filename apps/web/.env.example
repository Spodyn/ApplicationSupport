# Browser-visible, build-time configuration. Only these reviewed same-origin
# paths may use NEXT_PUBLIC_*. Never add signing secrets, bot tokens, client
# secrets, passwords, credentials, or private keys to this file.

NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_WS_BASE_URL=/ws

# Server-only, optional exact HTTPS development tunnel origin (no trailing slash).
# USI_DEV_PUBLIC_ORIGIN=https://your-development-tunnel.example.invalid
