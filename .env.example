# Local API configuration only. Copy to an ignored .env file and use only
# disposable development credentials. Staging and production must not use this
# file; they inject core credentials from a config tree and integration
# credentials through secret_ref-backed storage.

SPRING_PROFILES_ACTIVE=local

# Public, non-secret deployment and callback configuration.
USI_PUBLIC_BASE_URL=http://localhost:3000
USI_SLACK_CALLBACK_URL=https://replace-with-dev-tunnel.example.invalid/api/v1/provider-callbacks/slack
USI_TEAMS_CALLBACK_URL=https://replace-with-dev-tunnel.example.invalid/api/v1/provider-callbacks/teams
USI_TELEGRAM_CALLBACK_URL=https://replace-with-dev-tunnel.example.invalid/api/v1/provider-callbacks/telegram
USI_CORS_ALLOWED_ORIGINS=

# Local PostgreSQL only. Keep these values aligned with infra/.env.
USI_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/application_support_dev
USI_DATABASE_USERNAME=application_support_dev
USI_DATABASE_PASSWORD=postgres_dev_only_change_me

# Local RabbitMQ only.
USI_RABBITMQ_HOST=127.0.0.1
USI_RABBITMQ_PORT=5672
USI_RABBITMQ_VHOST=application_support_dev
USI_RABBITMQ_USERNAME=application_support_dev
USI_RABBITMQ_PASSWORD=rabbitmq_dev_only_change_me

# Local MinIO only.
USI_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
USI_OBJECT_STORAGE_REGION=us-east-1
USI_OBJECT_STORAGE_ACCESS_KEY=usi-dev-root
USI_OBJECT_STORAGE_SECRET_KEY=minio_dev_only_change_me
USI_ATTACHMENTS_BUCKET=usi-attachments-dev
USI_EXPORTS_BUCKET=usi-exports-dev

# Provider credentials do not belong here. Integration records contain only a
# secret_ref; local dummy provider credentials may be placed in this ignored,
# permission-restricted directory when provider adapters are implemented.
USI_INTEGRATION_SECRETS_DIRECTORY=/tmp/usi-local-integration-secrets/

# Optional provider identifiers are not secrets. Empty means not configured.
USI_SLACK_CLIENT_ID=
USI_TEAMS_CLIENT_ID=
USI_TEAMS_TENANT_ID=
USI_TELEGRAM_BOT_USERNAME=
