# Development-only defaults. Copy this file to infra/.env and never reuse these
# values outside a disposable local USI environment.

POSTGRES_DB=application_support_dev
POSTGRES_USER=application_support_dev
POSTGRES_PASSWORD=postgres_dev_only_change_me
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=application_support_dev
RABBITMQ_DEFAULT_PASS=rabbitmq_dev_only_change_me
RABBITMQ_DEFAULT_VHOST=application_support_dev
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

MINIO_ROOT_USER=usi-dev-root
MINIO_ROOT_PASSWORD=minio_dev_only_change_me
MINIO_ATTACHMENTS_BUCKET=usi-attachments-dev
MINIO_EXPORTS_BUCKET=usi-exports-dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
