# syntax=docker/dockerfile:1

ARG GO_IMAGE=golang:1.24.6-alpine3.22
ARG RUNTIME_IMAGE=alpine:3.22

FROM ${GO_IMAGE} AS build
ARG MINIO_TAG=RELEASE.2025-09-07T16-13-09Z
ARG MINIO_COMMIT=07c3a429bfed433e49018cb0f78a52145d4bedeb

RUN apk add --no-cache bash curl git make perl
WORKDIR /src/minio
RUN git init \
    && git remote add origin https://github.com/minio/minio.git \
    && git fetch --depth=1 origin "refs/tags/${MINIO_TAG}:refs/tags/${MINIO_TAG}" \
    && git checkout --detach "${MINIO_TAG}" \
    && test "$(git rev-parse HEAD)" = "${MINIO_COMMIT}" \
    && test "$(git describe --tags --exact-match)" = "${MINIO_TAG}"
RUN MINIO_RELEASE=RELEASE make build \
    && ./minio --version | grep -F "${MINIO_TAG}"

FROM ${RUNTIME_IMAGE}
RUN apk add --no-cache ca-certificates curl
COPY --from=build /src/minio/minio /usr/bin/minio
COPY --from=build /src/minio/LICENSE /usr/share/licenses/minio/LICENSE
ENTRYPOINT ["/usr/bin/minio"]
